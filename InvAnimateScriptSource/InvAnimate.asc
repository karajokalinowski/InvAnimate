// new module script
managed struct Animation {
  bool is_active;
  int current_delay_between_frames;
  int current_delay_between_loops;
  int current_frame;
  int delay_between_frames;
  int delay_between_loops;
  int loop;
  int num_loops;
  int view;
  InvAnimate_RepeatStyle repeat_style;
};
bool HideWhileActiveInventory[];
bool CopyNormalGraphicToCursor[];
bool PlayWhileBlocked[];
bool ShowBaseBetweenLoops[];
bool WaitForAnimations[];
int BaseGraphic[];
int BaseGraphicCursor[];
Animation* BaseAnimation[];
Animation* BaseAnimationCursor[];
Animation* CurrentAnimation[];
Animation* CurrentAnimationCursor[];
Animation* HeldAnimation[];
Animation* HeldAnimationCursor[];
DynamicSprite* EmptySprite;

function game_start() {
  HideWhileActiveInventory = new bool[Game.InventoryItemCount + 1];
  CopyNormalGraphicToCursor = new bool[Game.InventoryItemCount + 1];
  PlayWhileBlocked = new bool[Game.InventoryItemCount + 1];
  ShowBaseBetweenLoops = new bool[Game.InventoryItemCount + 1];
  WaitForAnimations = new bool[Game.InventoryItemCount + 1];
  BaseAnimation = new Animation[Game.InventoryItemCount + 1];
  BaseAnimationCursor = new Animation[Game.InventoryItemCount + 1];
  CurrentAnimation = new Animation[Game.InventoryItemCount + 1];
  CurrentAnimationCursor = new Animation[Game.InventoryItemCount + 1];
  HeldAnimation = new Animation[Game.InventoryItemCount + 1];
  HeldAnimationCursor = new Animation[Game.InventoryItemCount + 1];
  BaseGraphic = new int[Game.InventoryItemCount + 1];
  BaseGraphicCursor = new int[Game.InventoryItemCount + 1];
  EmptySprite = DynamicSprite.Create(1, 1);
  
  for (int current = 1; current <= Game.InventoryItemCount; current++) {
    ShowBaseBetweenLoops[current] = true;
    WaitForAnimations[current] = true;
    HideWhileActiveInventory[current] = true;
    PlayWhileBlocked[current] = true;
    BaseGraphic[current] = inventory[current].Graphic;
    BaseGraphicCursor[current] = inventory[current].CursorGraphic;
  }
}



function InvAnimate_ToggleHideWhileActiveInventory(this InventoryItem*, bool enabled) {
  HideWhileActiveInventory[this.ID] = enabled;
}
function InvAnimate_ToggleShowBaseBetweenLoops(this InventoryItem*, bool enabled) {
  ShowBaseBetweenLoops[this.ID] = enabled;
}

function InvAnimate_ToggleWaitForAnimations(this InventoryItem*, bool enabled) {
  WaitForAnimations[this.ID] = enabled;
}

function InvAnimate_TogglePlayWhileBlocked(this InventoryItem*, bool enabled) {
  PlayWhileBlocked[this.ID] = enabled;
}

function InvAnimate_ToggleCopyNormalGraphicToCursor(this InventoryItem*, bool enabled) {
  CopyNormalGraphicToCursor[this.ID] = enabled;
}

function IsActive(Animation* animation) {
  return (animation != null && animation.is_active);
}

function InvAnimate_SetBaseGraphic(this InventoryItem*, int sprite_index, InvAnimate_IconOption icon_option, bool delete_base_animation) {
  if (icon_option != eInvAnimate_Cursor) {
    BaseGraphic[this.ID] = sprite_index;
    if (delete_base_animation) {
      BaseAnimation[this.ID] = null;
    }
  }
  if (icon_option != eInvAnimate_Normal) {
    BaseGraphicCursor[this.ID] = sprite_index;
    if (delete_base_animation) {
      BaseAnimationCursor[this.ID] = null;
    }
  }
}

function InvAnimate_DisableBaseAnimation(this InventoryItem*, InvAnimate_IconOption icon_style) {
  if (icon_style == eInvAnimate_Both && BaseAnimation[this.ID] == null && BaseAnimationCursor[this.ID] == null 
  || icon_style == eInvAnimate_Normal && BaseAnimation[this.ID] == null
  || icon_style == eInvAnimate_Cursor && BaseAnimationCursor[this.ID] == null) {
    System.Log(eLogWarn, "Inventory item %s has no animation to disable.",  this.ScriptName);
    return;
  }
  if (icon_style != eInvAnimate_Cursor && BaseAnimation[this.ID] != null) {
    BaseAnimation[this.ID].is_active = false;
  }
  if (icon_style != eInvAnimate_Normal && BaseAnimationCursor[this.ID] != null) {
    BaseAnimationCursor[this.ID].is_active = false;
  }
}

function InvAnimate_EnableBaseAnimation(this InventoryItem*, InvAnimate_IconOption icon_style,  bool play_from_beginning) {
  if (icon_style == eInvAnimate_Both && BaseAnimation[this.ID] == null && BaseAnimationCursor[this.ID] == null 
  || icon_style == eInvAnimate_Normal && BaseAnimation[this.ID] == null
  || icon_style == eInvAnimate_Cursor && BaseAnimationCursor[this.ID] == null) {
    System.Log(eLogWarn, "Inventory item %s has no animation to enable.",  this.ScriptName);
    return;
  }
  if (icon_style != eInvAnimate_Cursor && BaseAnimation[this.ID] != null) {
    BaseAnimation[this.ID].is_active = true;
    if (play_from_beginning) {
      BaseAnimation[this.ID].current_frame = 0;
      BaseAnimation[this.ID].current_delay_between_loops = 0;
      BaseAnimation[this.ID].current_delay_between_frames = 0;
    }
  }
  if (icon_style != eInvAnimate_Normal && BaseAnimationCursor[this.ID] != null) {
    BaseAnimationCursor[this.ID].is_active = true;
    if (play_from_beginning) {
      BaseAnimationCursor[this.ID].current_frame = 0;
      BaseAnimationCursor[this.ID].current_delay_between_loops = 0;
      BaseAnimationCursor[this.ID].current_delay_between_frames = 0;
    }
  }
}

function InvAnimate_DisableAnimation(this InventoryItem*, InvAnimate_IconOption icon_style) {
  if (icon_style == eInvAnimate_Both && HeldAnimation[this.ID] == null && HeldAnimationCursor[this.ID] == null 
  || icon_style == eInvAnimate_Normal && HeldAnimation[this.ID] == null
  || icon_style == eInvAnimate_Cursor && HeldAnimationCursor[this.ID] == null) {
    System.Log(eLogWarn, "Inventory item %s has no animation to disable.",  this.ScriptName);
    return;
  }
  if (icon_style != eInvAnimate_Cursor && HeldAnimation[this.ID] != null) {
    HeldAnimation[this.ID].is_active = false;
  }
  if (icon_style != eInvAnimate_Normal && HeldAnimationCursor[this.ID] != null) {
    HeldAnimationCursor[this.ID].is_active = false;
  }
}

function InvAnimate_EnableAnimation(this InventoryItem*, InvAnimate_IconOption icon_style,  bool play_from_beginning) {
  if (icon_style == eInvAnimate_Both && HeldAnimation[this.ID] == null && HeldAnimationCursor[this.ID] == null 
  || icon_style == eInvAnimate_Normal && HeldAnimation[this.ID] == null
  || icon_style == eInvAnimate_Cursor && HeldAnimationCursor[this.ID] == null) {
    System.Log(eLogWarn, "Inventory item %s has no animation to enable.",  this.ScriptName);
    return;
  }
  if (icon_style != eInvAnimate_Cursor && HeldAnimation[this.ID] != null) {
    HeldAnimation[this.ID].is_active = true;
    if (play_from_beginning) {
      HeldAnimation[this.ID].current_frame = 0;
      HeldAnimation[this.ID].current_delay_between_loops = 0;
      HeldAnimation[this.ID].current_delay_between_frames = 0;
    }
  }
  if (icon_style != eInvAnimate_Normal && HeldAnimationCursor[this.ID] != null) {
    HeldAnimationCursor[this.ID].is_active = true;
    if (play_from_beginning) {
      HeldAnimationCursor[this.ID].current_frame = 0;
      HeldAnimationCursor[this.ID].current_delay_between_loops = 0;
      HeldAnimationCursor[this.ID].current_delay_between_frames = 0;
    }
  }
}

function InvAnimate_SetBaseAnimation(this InventoryItem*, int view, int loop, int delay, 
int delay_between_loops, InvAnimate_IconOption icon_style, bool enabled) {
  if (icon_style != eInvAnimate_Cursor) {
    BaseAnimation[this.ID] = new Animation;
    BaseAnimation[this.ID].is_active = true;
    BaseAnimation[this.ID].delay_between_frames = delay;
    BaseAnimation[this.ID].current_delay_between_frames = 0;
    BaseAnimation[this.ID].current_delay_between_loops = 0;
    BaseAnimation[this.ID].current_frame = 0;
    BaseAnimation[this.ID].loop = loop;
    BaseAnimation[this.ID].view = view;
    BaseAnimation[this.ID].delay_between_loops = delay_between_loops;
    BaseAnimation[this.ID].is_active = enabled;
    BaseAnimation[this.ID].repeat_style = eInvAnimate_RepeatForever;
    BaseAnimation[this.ID].num_loops = 1;
  }
  if (icon_style != eInvAnimate_Normal) {
    BaseAnimationCursor[this.ID] = new Animation;
    BaseAnimationCursor[this.ID].is_active = true;
    BaseAnimationCursor[this.ID].delay_between_frames = delay;
    BaseAnimationCursor[this.ID].current_delay_between_frames = 0;
    BaseAnimationCursor[this.ID].current_delay_between_loops = 0;
    BaseAnimationCursor[this.ID].current_frame = 0;
    BaseAnimationCursor[this.ID].loop = loop;
    BaseAnimationCursor[this.ID].view = view;
    BaseAnimationCursor[this.ID].delay_between_loops = delay_between_loops;
    BaseAnimationCursor[this.ID].is_active = enabled;
    BaseAnimationCursor[this.ID].repeat_style = eInvAnimate_RepeatForever;
    BaseAnimationCursor[this.ID].num_loops = 1;
  }
}

function InvAnimate_SetAnimation(this InventoryItem*, int view, int loop, int delay, 
int delay_between_loops, InvAnimate_RepeatStyle repeat_style, int num_loops, InvAnimate_IconOption icon_style, bool enabled) {
  if (icon_style != eInvAnimate_Cursor) {
    HeldAnimation[this.ID] = new Animation;
    HeldAnimation[this.ID].is_active = true;
    HeldAnimation[this.ID].delay_between_frames = delay;
    HeldAnimation[this.ID].current_delay_between_frames = 0;
    HeldAnimation[this.ID].current_delay_between_loops = delay_between_loops;
    HeldAnimation[this.ID].current_frame = 0;
    HeldAnimation[this.ID].loop = loop;
    HeldAnimation[this.ID].view = view;
    HeldAnimation[this.ID].delay_between_loops = delay_between_loops;
    HeldAnimation[this.ID].is_active = enabled;
    HeldAnimation[this.ID].repeat_style = repeat_style;
    HeldAnimation[this.ID].num_loops = num_loops;
  }
  if (icon_style != eInvAnimate_Normal) {
    HeldAnimationCursor[this.ID] = new Animation;
    HeldAnimationCursor[this.ID].is_active = true;
    HeldAnimationCursor[this.ID].delay_between_frames = delay;
    HeldAnimationCursor[this.ID].current_delay_between_frames = 0;
    HeldAnimationCursor[this.ID].current_delay_between_loops = delay_between_loops;
    HeldAnimationCursor[this.ID].current_frame = 0;
    HeldAnimationCursor[this.ID].loop = loop;
    HeldAnimationCursor[this.ID].view = view;
    HeldAnimationCursor[this.ID].delay_between_loops = delay_between_loops;
    HeldAnimationCursor[this.ID].is_active = enabled;
    HeldAnimationCursor[this.ID].repeat_style = repeat_style;
    HeldAnimationCursor[this.ID].num_loops = num_loops;
  }
}

function InvAnimate_UnsetBaseAnimation(this InventoryItem*,  InvAnimate_IconOption icon_style) {
  if (icon_style != eInvAnimate_Cursor) {
    BaseAnimation[this.ID] = null;
  }
  if (icon_style != eInvAnimate_Normal) {
    BaseAnimationCursor[this.ID] = null;
  }
}

function SetCurrentGraphic(this InventoryItem*) {
  if (CurrentAnimation[this.ID] == null || !CurrentAnimation[this.ID].is_active) {
    this.Graphic = BaseGraphic[this.ID];
  }
  else {
    ViewFrame* view_frame = Game.GetViewFrame(CurrentAnimation[this.ID].view, CurrentAnimation[this.ID].loop, CurrentAnimation[this.ID].current_frame);
    this.Graphic = view_frame.Graphic;
  }
}

function SetCurrentGraphicCursor(this InventoryItem*) {
  if (CopyNormalGraphicToCursor[this.ID]) {
    this.CursorGraphic = this.Graphic;
  }
  else if (CurrentAnimationCursor[this.ID] == null || !CurrentAnimationCursor[this.ID].is_active) {
    this.CursorGraphic = BaseGraphicCursor[this.ID];
  }
  else {
    ViewFrame* view_frame = Game.GetViewFrame(CurrentAnimationCursor[this.ID].view, CurrentAnimationCursor[this.ID].loop, CurrentAnimationCursor[this.ID].current_frame);
    this.CursorGraphic = view_frame.Graphic;
  }
}

function ChangeCurrentAnimation(this InventoryItem*, Animation* NewAnimation) {
  if (CurrentAnimation[this.ID] == NewAnimation) {
    //Do nothing
  }
  else {
    if (CurrentAnimation[this.ID] != null) {
      CurrentAnimation[this.ID].current_delay_between_loops = CurrentAnimation[this.ID].delay_between_loops;
      //CurrentAnimation[this.ID].current_frame = 0;
    }
    CurrentAnimation[this.ID] = NewAnimation;
  }
}

function ChangeCurrentAnimationCursor(this InventoryItem*, Animation* NewAnimation) {
  if (CurrentAnimationCursor[this.ID] == NewAnimation) {
    //Do nothing
  }
  else {
    if (CurrentAnimationCursor[this.ID] != null) {
      CurrentAnimationCursor[this.ID].current_delay_between_loops = CurrentAnimationCursor[this.ID].delay_between_loops;
      //CurrentAnimationCursor[this.ID].current_frame = 0;
    }
    CurrentAnimationCursor[this.ID] = NewAnimation;
  }
}

Animation* GetNextAnimation(this InventoryItem*) {
  if (!IsActive(CurrentAnimation[this.ID]) && !IsActive(BaseAnimation[this.ID]) && !IsActive(HeldAnimation[this.ID])) {
    //If there are no animations set, use the base graphic
    return null;
  }
  else if (!IsActive(CurrentAnimation[this.ID]) || !WaitForAnimations[this.ID]) {
    if (IsActive(HeldAnimation[this.ID]) && (!ShowBaseBetweenLoops[this.ID] || HeldAnimation[this.ID].current_delay_between_loops == 0)) {
      //If (there's no current animation OR you don't have to wait for animations), and there's a held animation, and (you don't have to show the base between loops, OR a held animation is ready to play), set held animation to current
      return HeldAnimation[this.ID];
    }
    else if (IsActive(BaseAnimation[this.ID])) {
      //If (there's no current animation OR you don't have to wait for animations), and there's a base animation, and no held animation OR (you have to show the base between loops, AND a held animation isn't ready to play), set base animation to current
      return BaseAnimation[this.ID];
    }
    else {
      //If (there's no current animation OR you don't have to wait for animations), and no base animation, and no held animation OR (you have to show the base between loops, AND a held animation isn't ready to play), set base graphic to current
      return null;
    }
  }
  else if (CurrentAnimation[this.ID].current_frame > 0) {
    //If there's a current animation, and you have to wait for held animations, and a current animation is already playing, then remain on the current animation
    return CurrentAnimation[this.ID];
  }
  else if (IsActive(HeldAnimation[this.ID])) {
    if (HeldAnimation[this.ID].current_delay_between_loops == 0 || !ShowBaseBetweenLoops[this.ID]) {
      //If there's a current animation and a held animation, and you have to wait for held animations, and the current animation isn't playing yet, and (the held animation is ready to play OR you don't show the base between loops), set base graphic to held
      return HeldAnimation[this.ID];
    }
    else if (IsActive(BaseAnimation[this.ID])) {
      //If there's a current animation and a held animation, and you have to wait for held animations, and the current animation isn't playing yet, and the held isn't ready to play, and you show base between loops, and the base animation exists, set current animation to base animation
      return BaseAnimation[this.ID];
    }
    else {
      //If there's a current animation and a held animation, and you have to wait for held animations, and the current animation isn't playing yet, and the held isn't ready to play, and you show base between loops, and the base animation doesn't exist, set base graphic to current
      return null;
    }
  }
  else if (IsActive(BaseAnimation[this.ID])) {
    //If there's no current animation or held animation, but there's a base animation, switch to the base animation
    return BaseAnimation[this.ID];
  }
  else if (IsActive(CurrentAnimation[this.ID])) {
    //If theres's a current animation, no base or held animations, and the current animation isn't ready to play yet, just leave it set to the current animation
    return CurrentAnimation[this.ID];
  }
  else {
    System.Log(eLogError, "It should not be possible to reach this error. If you see this error in your log, contact Kara Jo Kalinowski.");
    return CurrentAnimation[this.ID];
  }
}

Animation* GetNextAnimationCursor(this InventoryItem*) {
  if (!IsActive(CurrentAnimationCursor[this.ID]) && !IsActive(BaseAnimationCursor[this.ID]) && !IsActive(HeldAnimationCursor[this.ID])) {
    //If there are no animations set, use the base graphic
    return null;
  }
  else if (!IsActive(CurrentAnimationCursor[this.ID]) || !WaitForAnimations[this.ID]) {
    if (IsActive(HeldAnimationCursor[this.ID]) && (!ShowBaseBetweenLoops[this.ID] || HeldAnimationCursor[this.ID].current_delay_between_loops == 0)) {
      //If (there's no current animation OR you don't have to wait for animations), and there's a held animation, and (you don't have to show the base between loops, OR a held animation is ready to play), set held animation to current
      return HeldAnimationCursor[this.ID];
    }
    else if (IsActive(BaseAnimationCursor[this.ID])) {
      //If (there's no current animation OR you don't have to wait for animations), and there's a base animation, and no held animation OR (you have to show the base between loops, AND a held animation isn't ready to play), set base animation to current
      return BaseAnimationCursor[this.ID];
    }
    else {
      //If (there's no current animation OR you don't have to wait for animations), and no base animation, and no held animation OR (you have to show the base between loops, AND a held animation isn't ready to play), set base graphic to current
      return null;
    }
  }
  else if (CurrentAnimationCursor[this.ID].current_frame > 0) {
    //If there's a current animation, and you have to wait for held animations, and a current animation is already playing, then remain on the current animation
    return CurrentAnimationCursor[this.ID];
  }
  else if (IsActive(HeldAnimationCursor[this.ID])) {
    if (HeldAnimationCursor[this.ID].current_delay_between_loops == 0 || !ShowBaseBetweenLoops[this.ID]) {
      //If there's a current animation and a held animation, and you have to wait for held animations, and the current animation isn't playing yet, and (the held animation is ready to play OR you don't show the base between loops), set base graphic to held
      return HeldAnimationCursor[this.ID];
    }
    else if (IsActive(BaseAnimationCursor[this.ID])) {
      //If there's a current animation and a held animation, and you have to wait for held animations, and the current animation isn't playing yet, and the held isn't ready to play, and you show base between loops, and the base animation exists, set current animation to base animation
      return BaseAnimationCursor[this.ID];
    }
    else {
      //If there's a current animation and a held animation, and you have to wait for held animations, and the current animation isn't playing yet, and the held isn't ready to play, and you show base between loops, and the base animation doesn't exist, set base graphic to current
      return null;
    }
  }
  else if (IsActive(BaseAnimationCursor[this.ID])) {
    //If there's no current animation or held animation, but there's a base animation, switch to the base animation
    return BaseAnimationCursor[this.ID];
  }
  else if (IsActive(CurrentAnimationCursor[this.ID])) {
    //If theres's a current animation, no base or held animations, and the current animation isn't ready to play yet, just leave it set to the current animation
    return CurrentAnimationCursor[this.ID];
  }
  else {
    System.Log(eLogError, "It should not be possible to reach this error. If you see this error in your log, contact Kara Jo Kalinowski.");
    return CurrentAnimationCursor[this.ID];
  }
}

function SetCurrentAnimation(this InventoryItem*) {
  this.ChangeCurrentAnimation(this.GetNextAnimation());
}

function SetCurrentAnimationCursor(this InventoryItem*) {
  this.ChangeCurrentAnimationCursor(this.GetNextAnimationCursor());
}

bool ProcessDelay(this Animation*) {
  if (this.current_delay_between_loops > 0) {
    this.current_delay_between_loops--;
    return true;
  }
  else if (this.current_delay_between_frames > 0) {
    this.current_delay_between_frames--;
    return true;
  }
  else {
    this.current_frame++;
    if (this.current_frame >= Game.GetFrameCountForLoop(this.view, this.loop)) {
      this.current_frame = 0;
      this.current_delay_between_loops = this.delay_between_loops;
      if (this.repeat_style == eInvAnimate_RepeatFixed) {
        this.num_loops--;
      }
    }
    else {
      this.current_delay_between_frames = this.delay_between_frames;
    }
    if (this.repeat_style == eInvAnimate_RepeatFixed && this.num_loops <= 0) {
      return false;
    }
    else {
      return true;
    }
  }
}

function ProcessDelayBetweenLoops(this Animation*) {
  if (this.current_delay_between_loops > 0) {
    this.current_delay_between_loops--;
  }
}

function ProcessAnimation(this InventoryItem*) {
  if (IsActive(CurrentAnimation[this.ID])) {
    if (IsActive(HeldAnimation[this.ID]) && CurrentAnimation[this.ID] != HeldAnimation[this.ID]) {
      HeldAnimation[this.ID].ProcessDelayBetweenLoops();
    }
    if (!CurrentAnimation[this.ID].ProcessDelay()) {
      if (IsActive(HeldAnimation[this.ID]) && CurrentAnimation[this.ID] == HeldAnimation[this.ID]) {
        HeldAnimation[this.ID] = null;
      }
      CurrentAnimation[this.ID] = null;
    }
  }
  else if (IsActive(HeldAnimation[this.ID])) {
    HeldAnimation[this.ID].ProcessDelayBetweenLoops();
  }
  this.SetCurrentAnimation();
  this.SetCurrentGraphic();
  if (IsActive(CurrentAnimation[this.ID])) {
    if (!(IsActive(HeldAnimation[this.ID]) && CurrentAnimation[this.ID] == HeldAnimation[this.ID] || IsActive(BaseAnimation[this.ID]) && CurrentAnimation[this.ID] == BaseAnimation[this.ID])) {
      if (!WaitForAnimations[this.ID] || CurrentAnimation[this.ID].current_frame == 0) {
        CurrentAnimation[this.ID] = null;
        this.ProcessAnimation();
      }
    }
  }
}

function ProcessAnimationCursor(this InventoryItem*) {
  if (IsActive(CurrentAnimationCursor[this.ID])) {
    if (IsActive(HeldAnimationCursor[this.ID]) && CurrentAnimationCursor[this.ID] != HeldAnimationCursor[this.ID]) {
      HeldAnimationCursor[this.ID].ProcessDelayBetweenLoops();
    }
    if (!CurrentAnimationCursor[this.ID].ProcessDelay()) {
      if (IsActive(HeldAnimationCursor[this.ID]) && CurrentAnimationCursor[this.ID] == HeldAnimationCursor[this.ID]) {
        HeldAnimationCursor[this.ID] = null;
      }
      CurrentAnimationCursor[this.ID] = null;
    }
  }
  else if (IsActive(HeldAnimationCursor[this.ID])) {
    HeldAnimationCursor[this.ID].ProcessDelayBetweenLoops();
  }
  this.SetCurrentAnimationCursor();
  this.SetCurrentGraphicCursor();
  if (IsActive(CurrentAnimationCursor[this.ID])) {
    if (!(IsActive(HeldAnimationCursor[this.ID]) && CurrentAnimationCursor[this.ID] == HeldAnimationCursor[this.ID] || IsActive(BaseAnimationCursor[this.ID]) && CurrentAnimationCursor[this.ID] == BaseAnimationCursor[this.ID])) {
      if (!WaitForAnimations[this.ID] || CurrentAnimationCursor[this.ID].current_frame == 0) {
        CurrentAnimationCursor[this.ID] = null;
        this.ProcessAnimationCursor();
      }
    }
  }
}

function InvAnimate_PlayBlockingAnimation(this InventoryItem*, int view, int loop, int delay, int delay_between_loops, int num_loops) {
  bool play_while_blocked = PlayWhileBlocked[this.ID];
  PlayWhileBlocked[this.ID] = false;
  this.ProcessAnimation();
  while (WaitForAnimations[this.ID] && IsActive(CurrentAnimation[this.ID]) && CurrentAnimation[this.ID].current_frame > 1) {
    Wait(1);
    this.ProcessAnimation();
  }  
  for (int current_loop = 0; current_loop < num_loops; current_loop++) {
    for (int current_frame = 0; current_frame < Game.GetFrameCountForLoop(view, loop); current_frame++) {
      ViewFrame* view_frame = Game.GetViewFrame(view, loop, current_frame);
      this.Graphic = view_frame.Graphic;
      Wait(delay + 1);
    }
    Wait(delay_between_loops);
  }
  PlayWhileBlocked[this.ID] = play_while_blocked;
}

function repeatedly_execute() {
  for (int inventory_counter = 1; inventory_counter <= Game.InventoryItemCount; inventory_counter++) {
    if (!PlayWhileBlocked[inventory_counter]) {
      inventory[inventory_counter].ProcessAnimation();
      if (HideWhileActiveInventory[inventory_counter] && player.ActiveInventory != null && player.ActiveInventory.ID == inventory_counter) {
        inventory[inventory_counter].Graphic = EmptySprite.Graphic;
      }
      inventory[inventory_counter].ProcessAnimationCursor();
    }
  }
}

function repeatedly_execute_always() {
  for (int inventory_counter = 1; inventory_counter <= Game.InventoryItemCount; inventory_counter++) {
    if (PlayWhileBlocked[inventory_counter]) {
      inventory[inventory_counter].ProcessAnimation();
      if (HideWhileActiveInventory[inventory_counter] && player.ActiveInventory != null && player.ActiveInventory.ID == inventory_counter) {
        inventory[inventory_counter].Graphic = EmptySprite.Graphic;
      }
      inventory[inventory_counter].ProcessAnimationCursor();
    }
  }
}